# --- Repositories -------------------------------------------------------------
# Host directory holding the checkouts to index. Each subdirectory is one
# repository, addressed by its directory name in sync_repository. Mounted
# read-only; nothing is ever cloned, so no git credential enters the container.
REPOS_HOST_PATH=./repos

# --- Network ------------------------------------------------------------------
# The MCP endpoint's bind address on the host. 0.0.0.0 makes it reachable on the
# tailnet (and the LAN); clients connect to http://<tailnet-ip>:8000/mcp.
ENGINE_BIND=0.0.0.0

# Bind address for Qdrant (6333) and Postgres (5432).
#   0.0.0.0    published as the specification describes: any tailnet device can
#              reach Qdrant and Postgres with no credential.
#   127.0.0.1  reachable only from the host itself. Recommended; the engine talks
#              to both over the internal compose network either way.
INFRA_BIND=0.0.0.0

# Host-side ports for Qdrant and Postgres. Change them if the host already runs
# something on 6333 or 5432; the engine reaches both over the compose network,
# so only external clients see these.
QDRANT_HOST_PORT=6333
POSTGRES_HOST_PORT=5432

# Host:port values clients use, comma separated, e.g. "100.90.1.5:*,engine:*".
# Leave empty to accept any Host header. Setting it enables DNS-rebinding
# protection; if you set it and omit the address clients actually use, every
# request is answered with HTTP 421.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# --- Authentication -----------------------------------------------------------
# Empty by default: the tailnet is the trust boundary by explicit decision.
# Setting this requires `Authorization: Bearer <token>` on /mcp.
MCP_AUTH_TOKEN=

# --- Storage ------------------------------------------------------------------
POSTGRES_PASSWORD=postgres

# --- Documentation ------------------------------------------------------------
# ingest_document downloads only from these hosts (subdomains included), checked
# again on every redirect. Local files are read only beneath ./data.
DOCS_ALLOWED_HOSTS=docs.python.org,docs.pytest.org,docs.sqlalchemy.org,github.com,readthedocs.io

# --- Models -------------------------------------------------------------------
# Code-trained, 768 dimensions, 8k context window. The specification's
# bge-small-en-v1.5 has a 512-token window, which silently truncated any class
# larger than roughly 130 lines.
DENSE_MODEL=jinaai/jina-embeddings-v2-base-code
DENSE_DIM=768
SPARSE_MODEL=Qdrant/bm25
# Small cross-encoder: ~80MB, ~1s per reranked query on a 6-core CPU.
# BAAI/bge-reranker-base took 8-11s there for no measurable quality gain.
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Load both models during startup so the first query does not pay for a ~1GB
# download. /health returns 503 until they are ready.
EAGER_MODEL_LOAD=true

# --- Retrieval ----------------------------------------------------------------
DEFAULT_LIMIT=5
RERANK_CANDIDATES=10
# Ceiling on characters returned per hit. Every result carries exact line
# references, so the agent can open the file for the remainder.
MAX_RESULT_CHARS=1500

LOG_LEVEL=INFO
